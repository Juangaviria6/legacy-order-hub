DJANGO_SECRET_KEY=change-me-use-at-least-32-characters-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo para docker-compose (PostgreSQL). Sin DATABASE_URL se usa SQLite.
POSTGRES_DB=orderhub
POSTGRES_USER=orderhub
POSTGRES_PASSWORD=change-me-too

# Opcional: Redis (cola de eventos de órdenes)
# REDIS_URL=redis://localhost:6379/0
