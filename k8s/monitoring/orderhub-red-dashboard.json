{
  "title": "OrderHub - Métricas RED",
  "uid": "orderhub-red",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Rate: peticiones/s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{version}}",
          "expr": "sum by (version) (rate(django_http_responses_total_by_status_total[1m]))" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Errors: tasa de errores 5xx (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{version}}",
          "expr": "100 * sum by (version) (rate(django_http_responses_total_by_status_total{status=~\"5..\"}[1m])) / sum by (version) (rate(django_http_responses_total_by_status_total[1m]))" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Duration: latencia p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])))" },
        { "refId": "B", "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])))" },
        { "refId": "C", "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])))" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Peticiones por código de respuesta",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(django_http_responses_total_by_status_total[1m]))" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "Órdenes creadas (total)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(orderhub_orders_created_total)" } ]
    }
  ]
}
